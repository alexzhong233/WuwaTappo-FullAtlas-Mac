# 依赖与两平台共用的产物目录（macOS 与 Windows 都往 dist/ 交付）
/node_modules/
/dist/
/.work/
/outputs/
/release-assets/
.env
.env.*
!.env.example
*.p12
*.p8
.DS_Store

# macOS 侧（源码在 macos/，构建产物与缓存不入库）
/macos/frontend/
/macos/frontend-global/
/macos/build/
/macos/.work/
/macos/.cargo-check.log
/macos/.work-build.log
/macos/.workflow/
/macos/work/
/macos/src-tauri/target/
/macos/src-tauri/icons/
/macos/src-tauri/icons-global/
/macos/src-tauri/gen/

# Windows 侧产物与缓存（源码在 windows/，构建产物不入库）
/windows/app/
/windows/build/
/windows/.venv/
/windows/assets/
/windows/runtime/
/windows/cache/
/windows/cache_*/
/windows/*.log
/windows/local_config.json
/windows/offline_state.json
/windows/assistant_state.json
__pycache__/
*.pyc

# 本地工作区记忆与工具数据
/.workbuddy/
