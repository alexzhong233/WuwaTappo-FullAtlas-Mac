{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WuwaTappo Full Community",
  "version": "1.2.5",
  "identifier": "dev.w33d.wuwatappo.fullatlas.mac",
  "build": {
    "frontendDist": "../build/frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "desktop"
      ],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../licenses/FULLATLAS_LICENSE": "licenses/FULLATLAS_LICENSE",
      "../build/fullatlas-catalog.json": "fullatlas-catalog.json"
    },
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
